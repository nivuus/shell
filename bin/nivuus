#!/usr/bin/env bash
# bin/nivuus — point d'entrée unique de gestion de Nivuus Shell.
set -euo pipefail

NIVUUS_SRC_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=/dev/null
. "$NIVUUS_SRC_ROOT/lib/log.sh"
. "$NIVUUS_SRC_ROOT/lib/detect.sh"
. "$NIVUUS_SRC_ROOT/lib/manifest.sh"
. "$NIVUUS_SRC_ROOT/lib/zshrc.sh"
. "$NIVUUS_SRC_ROOT/lib/deps.sh"
. "$NIVUUS_SRC_ROOT/lib/steps.sh"

usage() {
    cat <<'EOF'
nivuus — gestion de Nivuus Shell

Usage :
  nivuus install   [--system|--user] [--dry-run] [--yes] [--prefix DIR] [--minimal] [--no-chsh]
  nivuus uninstall [--system|--user] [--dry-run] [--yes] [--purge]
  nivuus update
  nivuus doctor
  nivuus help

Modes :
  --system    Pour tous les utilisateurs de la machine : fichiers dans
              /usr/local/share/nivuus-shell, bloc Nivuus dans le zshrc global
              (/etc/zsh/zshrc ou /etc/zshrc), zsh comme shell de connexion de
              chaque compte. Relance via sudo si besoin. C'est le mode par
              défaut dès que root ou sudo est disponible.
  --user      Pour toi seulement : ~/.nivuus-shell et ~/.zshrc. Mode par
              défaut sans sudo, ou dès que --prefix est donné.

Dans les deux modes, les dépendances manquantes (zsh, git, curl) sont
installées avec le gestionnaire de paquets de la plateforme (via sudo hors
root), puis les outils optionnels (jq, fzf, eza, bat, fd, ripgrep, timg,
grc, git-delta) quand ils sont packagés.

Options :
  --dry-run   N'écrit rien ; affiche ce qui serait fait. Ne demande jamais sudo.
  --yes       Ne pose aucune question.
  --prefix    Répertoire d'installation (défaut : ~/.nivuus-shell).
  --minimal   Mode serveur/container : pas de chsh, pas d'outils optionnels.
  --no-chsh   Ne change aucun shell de connexion.
  --purge     (uninstall) supprime aussi l'état Nivuus (manifeste, sauvegardes).
              Ne supprime que ce que Nivuus a créé : ~/.zsh_local (si présent
              mais non créé par Nivuus) et ~/.zsh_history ne sont JAMAIS supprimés.
EOF
}

confirm() {
    [ -n "${ASSUME_YES:-}" ] && return 0
    nivuus_is_tty || return 0
    printf '%s [Y/n] ' "$1"
    local reply; read -r reply
    case "$reply" in [Nn]*) return 1 ;; *) return 0 ;; esac
}

# Mode d'installation effectif, posé dans NIVUUS_MODE.
#   $1 = mode explicite (--system / --user) ou vide
#   $2 = non vide si --prefix a été donné
# Sans flag : système dès que root ou sudo est disponible -- une seule
# commande doit équiper toute la machine, même lancée par un utilisateur
# ordinaire -- sinon utilisateur. Un sudo à mot de passe n'est tenté que si
# un terminal peut y répondre ; --dry-run ne demande jamais de privilège.
_nivuus_resolve_mode() {
    local explicit="$1" prefix_given="$2"
    if [ -n "$explicit" ]; then
        NIVUUS_MODE="$explicit"
    elif [ -n "$prefix_given" ]; then
        NIVUUS_MODE=user
    elif [ -n "${NIVUUS_DRY_RUN:-}" ] && ! nivuus_is_root; then
        NIVUUS_MODE=user
    elif nivuus_is_root || nivuus_sudo_available; then
        NIVUUS_MODE=system
    elif command -v sudo >/dev/null 2>&1 && nivuus_is_tty; then
        log_info "Installation pour tous les utilisateurs : sudo va demander ton mot de passe (--user pour n'installer que pour toi)."
        if sudo -v; then
            NIVUUS_MODE=system
        else
            log_warn "sudo refusé : installation pour toi seulement."
            NIVUUS_MODE=user
        fi
    else
        NIVUUS_MODE=user
    fi
    export NIVUUS_MODE
}

# Relance la même commande en root via sudo, en transmettant les réglages
# Nivuus de l'environnement (sudo les effacerait). NIVUUS_UID=0 est posé
# explicitement : un NIVUUS_UID simulé (tests) ne doit pas survivre à la
# relance, sinon le processus fils se relancerait à l'infini.
_nivuus_reexec_as_root() {
    local v envs=("NIVUUS_UID=0")
    for v in NIVUUS_STATE_DIR NIVUUS_SYSTEM_PREFIX NIVUUS_SYSTEM_STATE_DIR \
             NIVUUS_SYSTEM_ZSHRC NIVUUS_ETC_DIR NIVUUS_PKG_MANAGER NIVUUS_PASSWD \
             NIVUUS_LOGIN_DEFS NIVUUS_DRY_RUN NIVUUS_MINIMAL NIVUUS_QUIET \
             NIVUUS_CHARTE_MODE COLORFGBG; do
        [ -n "${!v:-}" ] && envs+=("$v=${!v}")
    done
    if ! command -v sudo >/dev/null 2>&1; then
        log_error "Privilèges root nécessaires et sudo introuvable. Relance en root : $NIVUUS_SRC_ROOT/bin/nivuus $*"
        return 1
    fi
    log_info "Privilèges root nécessaires : relance via sudo."
    exec sudo env "${envs[@]}" "$NIVUUS_SRC_ROOT/bin/nivuus" "$@"
}

cmd_install() {
    local prefix='' mode='' prefix_given='' no_chsh='' zshrc_target position \
          missing question
    local orig_args=("$@")
    while [ $# -gt 0 ]; do
        case "$1" in
            --dry-run) export NIVUUS_DRY_RUN=1 ;;
            --yes|-y)  ASSUME_YES=1 ;;
            --minimal) export NIVUUS_MINIMAL=1 ;;
            --system)  mode=system ;;
            --user)    mode=user ;;
            --no-chsh) no_chsh=1 ;;
            --prefix)
                shift
                [ $# -gt 0 ] || { log_error "L'option --prefix attend un chemin."; return 2; }
                prefix="$1"; prefix_given=1
                ;;
            *) log_error "Option inconnue : $1"; return 2 ;;
        esac
        shift
    done

    _nivuus_resolve_mode "$mode" "$prefix_given"
    if [ "$NIVUUS_MODE" = system ] && ! nivuus_is_root && [ -z "${NIVUUS_DRY_RUN:-}" ]; then
        # ${arr[@]+"${arr[@]}"} : bash < 4.4 refuse "${arr[@]}" sur un
        # tableau vide sous set -u.
        _nivuus_reexec_as_root install --system ${orig_args[@]+"${orig_args[@]}"}
        return 1
    fi

    if [ "$NIVUUS_MODE" = system ]; then
        : "${prefix:=$NIVUUS_SYSTEM_PREFIX}"
        : "${NIVUUS_STATE_DIR:=$NIVUUS_SYSTEM_STATE_DIR}"
        zshrc_target="$(nivuus_system_zshrc)"
        position=bottom
        question="Installer Nivuus Shell pour tous les utilisateurs (dans $prefix) ?"
    else
        : "${prefix:=$HOME/.nivuus-shell}"
        zshrc_target="$HOME/.zshrc"
        position=top
        question="Installer Nivuus Shell dans $prefix ?"
    fi
    export NIVUUS_STATE_DIR

    # shellcheck disable=SC2086  # liste séparée par des espaces
    missing="$(nivuus_deps_missing $NIVUUS_DEPS_REQUIRED)"
    if [ -n "$missing" ]; then
        if [ -n "$(nivuus_pkg_manager)" ]; then
            question="$question Dépendances à installer d'abord : $missing."
        else
            # Pas de gestionnaire de paquets : inutile d'aller plus loin.
            nivuus_step_check_required_deps || return 1
        fi
    fi
    confirm "$question" || { log_info "Annulé."; return 0; }

    nivuus_manifest_begin "$NIVUUS_MODE" "$prefix"
    # Hérite les entrées d'une installation précédente ET pose elle-même la
    # marque post-inherit dont nivuus_manifest_abort a besoin pour ne
    # défaire que sa propre part si CETTE installation échoue, jamais une
    # installation précédente qui a réussi (voir le commentaire de
    # nivuus_manifest_inherit).
    nivuus_manifest_inherit
    # ~/.cache n'est créé par aucune étape d'installation : Nivuus n'y écrit
    # que plus tard, à l'exécution du shell (config/22-ai-errors.zsh,
    # config/20-terminal-title.zsh...), hors du manifeste. On journalise
    # ici, une fois pour toutes, le SEUL fait qui compte pour un futur
    # uninstall --purge : ce répertoire existait-il déjà avant que Nivuus ne
    # s'en approche ? S'il existe déjà, on ne journalise rien -- uninstall
    # ne le supprimera donc jamais, préexistant ou non. S'il n'existe pas
    # encore, un MKDIR l'autorise à être repris par rmdir plus tard s'il
    # finit vide -- sans jamais toucher à un ~/.cache non vide ou déjà là.
    # En mode système, ~/.cache appartient à chaque utilisateur : on n'y
    # touche pas.
    if [ "$NIVUUS_MODE" = user ] && [ ! -d "$HOME/.cache" ]; then
        nivuus_manifest_record MKDIR "$HOME/.cache" '-' '-'
    fi
    # shellcheck disable=SC2086
    if ! nivuus_step_install_packages required $NIVUUS_DEPS_REQUIRED \
        || ! nivuus_step_copy_tree "$NIVUUS_SRC_ROOT" "$prefix" \
        || ! nivuus_step_write_version "$NIVUUS_SRC_ROOT" "$prefix" \
        || ! nivuus_step_write_zshrc "$zshrc_target" "$prefix" "$position"; then
        log_error "Installation interrompue."
        # Le manifeste n'a jamais été committé (voir nivuus_manifest_commit
        # plus bas) : sans ceci, tout ce que les étapes précédentes ont déjà
        # écrit sur le disque resterait orphelin -- uninstall ne verrait
        # jamais de manifeste et répondrait "rien à faire".
        nivuus_manifest_abort
        return 1
    fi

    # Shell de connexion et outils optionnels : jamais bloquants (chaque
    # étape se résout en un conseil si elle échoue), sautés en --minimal.
    if [ -z "${NIVUUS_MINIMAL:-}" ] && [ -z "$no_chsh" ]; then
        if [ "$NIVUUS_MODE" = system ]; then
            nivuus_step_chsh_all_users
        else
            nivuus_step_chsh "$(id -un)"
        fi
    fi
    if [ -z "${NIVUUS_MINIMAL:-}" ]; then
        # shellcheck disable=SC2086
        nivuus_step_install_packages optional $NIVUUS_DEPS_OPTIONAL
    fi
    nivuus_manifest_commit

    if [ -n "${NIVUUS_DRY_RUN:-}" ]; then
        log_info "Aucune modification effectuée (--dry-run)."
    elif [ "$NIVUUS_MODE" = system ]; then
        log_ok "Nivuus Shell installé pour tous les utilisateurs dans $prefix"
        log_info "Ouvre un nouveau terminal, ou lance « exec zsh » pour démarrer."
    else
        log_ok "Nivuus Shell installé dans $prefix"
        log_info "Lance « exec zsh » pour démarrer."
    fi
}

# Mode d'un manifeste d'après son en-tête (mode=user|system), "user" à défaut.
_nivuus_manifest_mode() {
    local m
    m="$(head -n1 "$1" 2>/dev/null | tr '\t' '\n' | sed -n 's/^mode=//p')"
    printf '%s\n' "${m:-user}"
}

cmd_uninstall() {
    local purge='' mode='' f name mkdir_levels level header kept_refs user_state
    local orig_args=("$@")
    while [ $# -gt 0 ]; do
        case "$1" in
            --dry-run) export NIVUUS_DRY_RUN=1 ;;
            --yes|-y)  ASSUME_YES=1 ;;
            --purge)   purge=1 ;;
            --system)  mode=system ;;
            --user)    mode=user ;;
            *) log_error "Option inconnue : $1"; return 2 ;;
        esac
        shift
    done

    # Quel manifeste ? Explicite par --system/--user ; sinon celui de
    # l'utilisateur s'il existe (son en-tête dit son mode), à défaut celui
    # du système.
    user_state="${NIVUUS_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/nivuus}"
    if [ -z "$mode" ]; then
        if [ -f "$user_state/manifest.tsv" ]; then
            mode="$(_nivuus_manifest_mode "$user_state/manifest.tsv")"
        elif [ -f "$NIVUUS_SYSTEM_STATE_DIR/manifest.tsv" ]; then
            mode=system
        else
            mode=user
        fi
    fi
    NIVUUS_MODE="$mode"; export NIVUUS_MODE

    if [ "$NIVUUS_MODE" = system ]; then
        : "${NIVUUS_STATE_DIR:=$NIVUUS_SYSTEM_STATE_DIR}"
    else
        NIVUUS_STATE_DIR="$user_state"
    fi
    export NIVUUS_STATE_DIR
    NIVUUS_MANIFEST="$NIVUUS_STATE_DIR/manifest.tsv"
    NIVUUS_BACKUP_DIR="$NIVUUS_STATE_DIR/backups"

    if [ ! -f "$NIVUUS_MANIFEST" ]; then
        log_info "Aucune installation Nivuus tracée ; rien à faire."
        return 0
    fi

    if [ "$NIVUUS_MODE" = system ] && ! nivuus_is_root && [ -z "${NIVUUS_DRY_RUN:-}" ]; then
        _nivuus_reexec_as_root uninstall --system ${orig_args[@]+"${orig_args[@]}"}
        return 1
    fi

    if [ "$NIVUUS_MODE" = system ]; then
        confirm "Désinstaller Nivuus Shell pour tous les utilisateurs et restaurer la configuration d'origine ?" \
            || { log_info "Annulé."; return 0; }
    else
        confirm "Désinstaller Nivuus Shell et restaurer la configuration d'origine ?" \
            || { log_info "Annulé."; return 0; }
    fi

    # Ligne d'en-tête, gardée au cas où le manifeste doive être réécrit
    # (entrées non appliquées : voir NIVUUS_ROLLBACK_SURVIVORS ci-dessous).
    header="$(head -n1 "$NIVUUS_MANIFEST")"
    NIVUUS_ROLLBACK_SURVIVORS="$(mktemp)"
    # Sauvegardes qu'une entrée résolue autrement (ex : bloc Nivuus retiré
    # d'un .zshrc divergé plutôt que restauration complète) veut malgré tout
    # protéger d'un --purge -- distinct des survivants : l'entrée elle-même
    # N'A PAS besoin d'être rejouée plus tard, seule sa sauvegarde doit
    # rester valide pour le pointeur qu'on vient d'afficher.
    NIVUUS_KEPT_BACKUP_REFS="$(mktemp)"
    nivuus_manifest_rollback

    if [ -n "$purge" ] && [ -z "${NIVUUS_DRY_RUN:-}" ]; then
        # On ne supprime QUE ce que Nivuus a créé, jamais un répertoire en bloc.
        # Les artefacts sous $HOME appartiennent à chaque utilisateur : en
        # mode système on n'y touche pas (ils tiennent dans ~/.cache).
        if [ "$NIVUUS_MODE" = user ] && [ -f "$HOME/.zsh_local" ]; then
            log_info "~/.zsh_local n'a pas été créé par Nivuus : conservé. Supprime-le à la main si tu le souhaites."
        fi
        # Artefacts d'exécution écrits par le shell une fois la session
        # démarrée (config/20-autoupdate.zsh, config/22-ai-errors.zsh, etc.),
        # donc jamais journalisés au moment de l'installation. Reconnus par
        # leur nom exact -- propre à Nivuus -- jamais par un motif large :
        # aucun rm -rf sur un répertoire qui pourrait contenir autre chose.
        [ "$NIVUUS_MODE" = user ] && [ -f "$HOME/.nivuus-shell-last-update-check" ] && rm -f "$HOME/.nivuus-shell-last-update-check"
        if [ "$NIVUUS_MODE" = user ] && [ -d "$HOME/.cache/nivuus-shell" ]; then
            find "$HOME/.cache/nivuus-shell" -type f -exec rm -f {} + 2>/dev/null || true
            find "$HOME/.cache/nivuus-shell" -depth -type d -exec rmdir {} + 2>/dev/null || true
            # ~/.cache lui-même n'est PAS supprimé ici : on ne sait pas, à cet
            # instant, s'il préexistait à Nivuus. C'est exactement ce que le
            # MKDIR conditionnel posé par cmd_install journalise -- il n'est
            # présent que si ~/.cache n'existait pas avant l'installation --
            # et le rejeu générique des MKDIR ci-dessous s'en charge, avec la
            # même prudence (rmdir échoue silencieusement si non vide) que
            # pour $NIVUUS_STATE_DIR et ses parents.
        fi
        # ~/.local, ~/.local/state et l'état Nivuus lui-même sont journalisés
        # en MKDIR par nivuus_manifest_begin, comme toute autre mutation :
        # rien n'est deviné ici. Mais nivuus_manifest_rollback (déjà exécuté
        # ci-dessus) ne peut pas les vider : le manifeste et les sauvegardes
        # qu'il vient de lire vivent dedans. On capture donc la liste avant
        # de les effacer, puis on la rejoue une seconde fois une fois l'état
        # supprimé. rmdir échoue silencieusement sur un répertoire absent ou
        # toujours non vide, donc ceci ne supprime jamais rien de préexistant
        # ni de non enregistré.
        mkdir_levels="$(awk -F"$NIVUUS_TAB" '$1=="MKDIR"{print $2}' "$NIVUUS_MANIFEST" 2>/dev/null || true)"
        # Sauvegardes encore référencées par une entrée que le rollback n'a
        # PAS pu appliquer (fichier divergé, sauvegarde déjà absente...) :
        # on vient d'en afficher le chemin à l'utilisateur comme point de
        # récupération, --purge ne doit pas l'invalider dans la foulée.
        kept_refs="$(
            { awk -F"$NIVUUS_TAB" '$4 != "-" {print $4}' "$NIVUUS_ROLLBACK_SURVIVORS" 2>/dev/null
              cat "$NIVUUS_KEPT_BACKUP_REFS" 2>/dev/null
            } || true
        )"
        if [ -s "$NIVUUS_ROLLBACK_SURVIVORS" ]; then
            { printf '%s\n' "$header"; cat "$NIVUUS_ROLLBACK_SURVIVORS"; } > "$NIVUUS_MANIFEST"
        else
            rm -f "$NIVUUS_MANIFEST"
        fi
        if [ -d "$NIVUUS_BACKUP_DIR" ]; then
            for f in "$NIVUUS_BACKUP_DIR"/*; do
                [ -f "$f" ] || continue
                name="${f##*/}"
                # Une sauvegarde Nivuus porte son sha256 : 64 caractères hexadécimaux, rien d'autre.
                case "$name" in
                    *[!0-9a-f]*) continue ;;
                esac
                [ ${#name} -eq 64 ] || continue
                if [ -n "$kept_refs" ] && printf '%s\n' "$kept_refs" | grep -qxF "$name"; then
                    continue
                fi
                rm -f "$f"
            done
            rmdir "$NIVUUS_BACKUP_DIR" 2>/dev/null || true
        fi
        if [ -n "$mkdir_levels" ]; then
            printf '%s\n' "$mkdir_levels" | sed '1!G;h;$!d' | while IFS= read -r level; do
                [ -z "$level" ] && continue
                rmdir "$level" 2>/dev/null || true
            done
        fi
        log_info "État Nivuus supprimé (--purge). L'historique et les fichiers non créés par Nivuus sont conservés."
    elif [ -z "${NIVUUS_DRY_RUN:-}" ]; then
        if [ -s "$NIVUUS_ROLLBACK_SURVIVORS" ]; then
            { printf '%s\n' "$header"; cat "$NIVUUS_ROLLBACK_SURVIVORS"; } > "$NIVUUS_MANIFEST"
        else
            rm -f "$NIVUUS_MANIFEST"
        fi
    fi
    rm -f "$NIVUUS_ROLLBACK_SURVIVORS" "$NIVUUS_KEPT_BACKUP_REFS"

    if [ -n "${NIVUUS_DRY_RUN:-}" ]; then
        log_info "Aucune modification effectuée (--dry-run)."
    elif [ "$NIVUUS_MODE" = system ]; then
        log_ok "Nivuus Shell désinstallé pour tous les utilisateurs."
    else
        log_ok "Nivuus Shell désinstallé."
    fi
}

main() {
    local cmd="${1:-help}"
    [ $# -gt 0 ] && shift
    case "$cmd" in
        install)   cmd_install "$@" ;;
        uninstall) cmd_uninstall "$@" ;;
        update)    exec zsh -ic 'nivuus-update' ;;
        doctor)    exec "$NIVUUS_SRC_ROOT/bin/healthcheck" ;;
        help|--help|-h) usage ;;
        *) log_error "Sous-commande inconnue : $cmd"; usage >&2; return 2 ;;
    esac
}

main "$@"
