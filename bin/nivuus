#!/usr/bin/env bash
# bin/nivuus — point d'entrée unique de gestion de Nivuus Shell.
set -euo pipefail

NIVUUS_SRC_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=/dev/null
. "$NIVUUS_SRC_ROOT/lib/log.sh"
. "$NIVUUS_SRC_ROOT/lib/detect.sh"
. "$NIVUUS_SRC_ROOT/lib/manifest.sh"
. "$NIVUUS_SRC_ROOT/lib/zshrc.sh"
. "$NIVUUS_SRC_ROOT/lib/steps.sh"

usage() {
    cat <<'EOF'
nivuus — gestion de Nivuus Shell

Usage :
  nivuus install   [--dry-run] [--yes] [--prefix DIR] [--minimal]
  nivuus uninstall [--dry-run] [--yes] [--purge]
  nivuus update
  nivuus doctor
  nivuus help

Options :
  --dry-run   N'écrit rien ; affiche ce qui serait fait.
  --yes       Ne pose aucune question.
  --prefix    Répertoire d'installation (défaut : ~/.nivuus-shell).
  --minimal   Mode serveur/container : pas de chsh, pas d'extras.
  --purge     (uninstall) supprime aussi l'état Nivuus (manifeste, sauvegardes).
              Ne supprime que ce que Nivuus a créé : ~/.zsh_local (si présent
              mais non créé par Nivuus) et ~/.zsh_history ne sont JAMAIS supprimés.
EOF
}

confirm() {
    [ -n "${ASSUME_YES:-}" ] && return 0
    nivuus_is_tty || return 0
    printf '%s [Y/n] ' "$1"
    local reply; read -r reply
    case "$reply" in [Nn]*) return 1 ;; *) return 0 ;; esac
}

cmd_install() {
    local prefix="$HOME/.nivuus-shell"
    while [ $# -gt 0 ]; do
        case "$1" in
            --dry-run) export NIVUUS_DRY_RUN=1 ;;
            --yes|-y)  ASSUME_YES=1 ;;
            --minimal) export NIVUUS_MINIMAL=1 ;;
            --prefix)
                shift
                [ $# -gt 0 ] || { log_error "L'option --prefix attend un chemin."; return 2; }
                prefix="$1"
                ;;
            *) log_error "Option inconnue : $1"; return 2 ;;
        esac
        shift
    done

    nivuus_step_check_required_deps || return 1
    confirm "Installer Nivuus Shell dans $prefix ?" || { log_info "Annulé."; return 0; }

    nivuus_manifest_begin user "$prefix"
    nivuus_manifest_inherit
    # Marque la frontière entre ce qu'une précédente installation avait déjà
    # posé (hérité ci-dessus) et ce que CETTE installation ajoute : si elle
    # échoue, nivuus_manifest_abort ne doit défaire que sa propre part, pas
    # réutiliser rétroactivement une installation précédente qui a réussi.
    nivuus_manifest_watermark_capture
    if ! nivuus_step_copy_tree "$NIVUUS_SRC_ROOT" "$prefix" \
        || ! nivuus_step_write_version "$NIVUUS_SRC_ROOT" "$prefix" \
        || ! nivuus_step_write_zshrc "$HOME/.zshrc" "$prefix"; then
        log_error "Installation interrompue."
        # Le manifeste n'a jamais été committé (voir nivuus_manifest_commit
        # plus bas) : sans ceci, tout ce que les étapes précédentes ont déjà
        # écrit sur le disque resterait orphelin -- uninstall ne verrait
        # jamais de manifeste et répondrait "rien à faire".
        nivuus_manifest_abort
        return 1
    fi
    nivuus_manifest_commit

    if [ -n "${NIVUUS_DRY_RUN:-}" ]; then
        log_info "Aucune modification effectuée (--dry-run)."
    else
        log_ok "Nivuus Shell installé dans $prefix"
        log_info "Lance « exec zsh » pour démarrer."
    fi
}

cmd_uninstall() {
    local purge='' f name mkdir_levels level header kept_refs
    while [ $# -gt 0 ]; do
        case "$1" in
            --dry-run) export NIVUUS_DRY_RUN=1 ;;
            --yes|-y)  ASSUME_YES=1 ;;
            --purge)   purge=1 ;;
            *) log_error "Option inconnue : $1"; return 2 ;;
        esac
        shift
    done

    : "${NIVUUS_STATE_DIR:=${XDG_STATE_HOME:-$HOME/.local/state}/nivuus}"
    NIVUUS_MANIFEST="$NIVUUS_STATE_DIR/manifest.tsv"
    NIVUUS_BACKUP_DIR="$NIVUUS_STATE_DIR/backups"

    if [ ! -f "$NIVUUS_MANIFEST" ]; then
        log_info "Aucune installation Nivuus tracée ; rien à faire."
        return 0
    fi

    confirm "Désinstaller Nivuus Shell et restaurer la configuration d'origine ?" \
        || { log_info "Annulé."; return 0; }

    # Ligne d'en-tête, gardée au cas où le manifeste doive être réécrit
    # (entrées non appliquées : voir NIVUUS_ROLLBACK_SURVIVORS ci-dessous).
    header="$(head -n1 "$NIVUUS_MANIFEST")"
    NIVUUS_ROLLBACK_SURVIVORS="$(mktemp)"
    # Sauvegardes qu'une entrée résolue autrement (ex : bloc Nivuus retiré
    # d'un .zshrc divergé plutôt que restauration complète) veut malgré tout
    # protéger d'un --purge -- distinct des survivants : l'entrée elle-même
    # N'A PAS besoin d'être rejouée plus tard, seule sa sauvegarde doit
    # rester valide pour le pointeur qu'on vient d'afficher.
    NIVUUS_KEPT_BACKUP_REFS="$(mktemp)"
    nivuus_manifest_rollback

    if [ -n "$purge" ] && [ -z "${NIVUUS_DRY_RUN:-}" ]; then
        # On ne supprime QUE ce que Nivuus a créé, jamais un répertoire en bloc.
        if [ -f "$HOME/.zsh_local" ]; then
            log_info "~/.zsh_local n'a pas été créé par Nivuus : conservé. Supprime-le à la main si tu le souhaites."
        fi
        # Artefacts d'exécution écrits par le shell une fois la session
        # démarrée (config/20-autoupdate.zsh, config/22-ai-errors.zsh, etc.),
        # donc jamais journalisés au moment de l'installation. Reconnus par
        # leur nom exact -- propre à Nivuus -- jamais par un motif large :
        # aucun rm -rf sur un répertoire qui pourrait contenir autre chose.
        [ -f "$HOME/.nivuus-shell-last-update-check" ] && rm -f "$HOME/.nivuus-shell-last-update-check"
        if [ -d "$HOME/.cache/nivuus-shell" ]; then
            find "$HOME/.cache/nivuus-shell" -type f -exec rm -f {} +
            find "$HOME/.cache/nivuus-shell" -depth -type d -exec rmdir {} + 2>/dev/null || true
            # ~/.cache lui-même n'est pas à nous (d'autres apps y écrivent) :
            # rmdir échoue silencieusement s'il contient autre chose, ne le
            # supprime que s'il ne restait que le sous-répertoire Nivuus.
            rmdir "$HOME/.cache" 2>/dev/null || true
        fi
        # ~/.local, ~/.local/state et l'état Nivuus lui-même sont journalisés
        # en MKDIR par nivuus_manifest_begin, comme toute autre mutation :
        # rien n'est deviné ici. Mais nivuus_manifest_rollback (déjà exécuté
        # ci-dessus) ne peut pas les vider : le manifeste et les sauvegardes
        # qu'il vient de lire vivent dedans. On capture donc la liste avant
        # de les effacer, puis on la rejoue une seconde fois une fois l'état
        # supprimé. rmdir échoue silencieusement sur un répertoire absent ou
        # toujours non vide, donc ceci ne supprime jamais rien de préexistant
        # ni de non enregistré.
        mkdir_levels="$(awk -F"$NIVUUS_TAB" '$1=="MKDIR"{print $2}' "$NIVUUS_MANIFEST" 2>/dev/null || true)"
        # Sauvegardes encore référencées par une entrée que le rollback n'a
        # PAS pu appliquer (fichier divergé, sauvegarde déjà absente...) :
        # on vient d'en afficher le chemin à l'utilisateur comme point de
        # récupération, --purge ne doit pas l'invalider dans la foulée.
        kept_refs="$(
            { awk -F"$NIVUUS_TAB" '$4 != "-" {print $4}' "$NIVUUS_ROLLBACK_SURVIVORS" 2>/dev/null
              cat "$NIVUUS_KEPT_BACKUP_REFS" 2>/dev/null
            } || true
        )"
        if [ -s "$NIVUUS_ROLLBACK_SURVIVORS" ]; then
            { printf '%s\n' "$header"; cat "$NIVUUS_ROLLBACK_SURVIVORS"; } > "$NIVUUS_MANIFEST"
        else
            rm -f "$NIVUUS_MANIFEST"
        fi
        if [ -d "$NIVUUS_BACKUP_DIR" ]; then
            for f in "$NIVUUS_BACKUP_DIR"/*; do
                [ -f "$f" ] || continue
                name="${f##*/}"
                # Une sauvegarde Nivuus porte son sha256 : 64 caractères hexadécimaux, rien d'autre.
                case "$name" in
                    *[!0-9a-f]*) continue ;;
                esac
                [ ${#name} -eq 64 ] || continue
                if [ -n "$kept_refs" ] && printf '%s\n' "$kept_refs" | grep -qxF "$name"; then
                    continue
                fi
                rm -f "$f"
            done
            rmdir "$NIVUUS_BACKUP_DIR" 2>/dev/null || true
        fi
        if [ -n "$mkdir_levels" ]; then
            printf '%s\n' "$mkdir_levels" | sed '1!G;h;$!d' | while IFS= read -r level; do
                [ -z "$level" ] && continue
                rmdir "$level" 2>/dev/null || true
            done
        fi
        log_info "État Nivuus supprimé (--purge). L'historique et les fichiers non créés par Nivuus sont conservés."
    elif [ -z "${NIVUUS_DRY_RUN:-}" ]; then
        if [ -s "$NIVUUS_ROLLBACK_SURVIVORS" ]; then
            { printf '%s\n' "$header"; cat "$NIVUUS_ROLLBACK_SURVIVORS"; } > "$NIVUUS_MANIFEST"
        else
            rm -f "$NIVUUS_MANIFEST"
        fi
    fi
    rm -f "$NIVUUS_ROLLBACK_SURVIVORS" "$NIVUUS_KEPT_BACKUP_REFS"

    if [ -n "${NIVUUS_DRY_RUN:-}" ]; then
        log_info "Aucune modification effectuée (--dry-run)."
    else
        log_ok "Nivuus Shell désinstallé."
    fi
}

main() {
    local cmd="${1:-help}"
    [ $# -gt 0 ] && shift
    case "$cmd" in
        install)   cmd_install "$@" ;;
        uninstall) cmd_uninstall "$@" ;;
        update)    exec zsh -ic 'nivuus-update' ;;
        doctor)    exec "$NIVUUS_SRC_ROOT/bin/healthcheck" ;;
        help|--help|-h) usage ;;
        *) log_error "Sous-commande inconnue : $cmd"; usage >&2; return 2 ;;
    esac
}

main "$@"
