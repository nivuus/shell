#!/usr/bin/env bash
# =============================================================================
# Nivuus Shell Benchmark
# =============================================================================
# Performance testing and analysis
# =============================================================================

set -e

# Detect shell configuration file
NIVUUS_DIR="${NIVUUS_SHELL_DIR:-$HOME/.nivuus-shell}"
ZSHRC_FILE="${NIVUUS_SHELL_DIR:+$NIVUUS_SHELL_DIR/.zshrc}"
ZSHRC_FILE="${ZSHRC_FILE:-$HOME/.zshrc}"

# Couleurs — lib/charte.sh est la source unique (doc/CHARTE.md).
_HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$_HERE/../lib/charte.sh" ]; then . "$_HERE/../lib/charte.sh"; fi

GREEN="${NIVUUS_C_OK:-}"
YELLOW="${NIVUUS_C_WARN:-}"
RED="${NIVUUS_C_DANGER:-}"
STRONG="${NIVUUS_C_STRONG:-}"
NC="${NIVUUS_C_OFF:-}"

echo "═══════════════════════════════════════════"
echo -e "${STRONG}  Nivuus Shell - Performance Benchmark${NC}"
echo "═══════════════════════════════════════════"
echo ""

# =============================================================================
# Full Shell Load Time
# =============================================================================

echo -e "${STRONG}Full Shell Load Time${NC}"
echo "─────────────────────────────────────────────"

runs=5
total=0

for ((i=1; i<=runs; i++)); do
    temp_file=$(mktemp)
    cat > "$temp_file" << EOF
#!/usr/bin/env zsh
zmodload zsh/datetime
start=\$EPOCHREALTIME
source "$ZSHRC_FILE"
end=\$EPOCHREALTIME
printf "%.2f" \$(( (\$end - \$start) * 1000 ))
EOF

    load_time=$(zsh "$temp_file" 2>/dev/null)
    rm -f "$temp_file"

    total=$(awk "BEGIN {print $total + $load_time}")
    echo "  Run $i: ${load_time}ms"
done

average=$(awk "BEGIN {printf \"%.2f\", $total / $runs}")
echo ""
echo "Average: ${average}ms"

avg_int=${average%.*}
if (( avg_int < 300 )); then
    echo -e "${GREEN}✓ Excellent (<300ms)${NC}"
elif (( avg_int < 500 )); then
    echo -e "${GREEN}✓ Good (<500ms)${NC}"
else
    echo -e "${YELLOW}⚠ Slow (>500ms)${NC}"
fi
echo ""

# =============================================================================
# Module Load Times
# =============================================================================

echo -e "${STRONG}Individual Module Load Times${NC}"
echo "─────────────────────────────────────────────"

if [[ -d "$NIVUUS_DIR/config" ]]; then
    for config_file in "$NIVUUS_DIR"/config/*.zsh; do
        module_name=$(basename "$config_file")

        temp_file=$(mktemp)
        cat > "$temp_file" << EOF
#!/usr/bin/env zsh
zmodload zsh/datetime
export NIVUUS_SHELL_DIR="$NIVUUS_DIR"
start=\$EPOCHREALTIME
source "$config_file"
end=\$EPOCHREALTIME
printf "%.2f" \$(( (\$end - \$start) * 1000 ))
EOF

        module_time=$(zsh "$temp_file" 2>/dev/null || echo "0")
        rm -f "$temp_file"

        printf "  %-30s %6.2fms\n" "$module_name" "$module_time"
    done
else
    echo "  Config directory not found: $NIVUUS_DIR/config"
fi
echo ""

# =============================================================================
# Command Execution Speed
# =============================================================================

echo -e "${STRONG}Command Execution Speed${NC}"
echo "─────────────────────────────────────────────"

# Test simple commands in ZSH context
temp_file=$(mktemp)
cat > "$temp_file" << 'EOF'
#!/usr/bin/env zsh
zmodload zsh/datetime

test_command() {
    local cmd="$1"
    local runs=10
    local total=0

    for ((i=1; i<=runs; i++)); do
        start=$EPOCHREALTIME
        eval "$cmd" &>/dev/null
        end=$EPOCHREALTIME
        duration=$(( ($end - $start) * 1000 ))
        total=$(awk "BEGIN {print $total + $duration}")
    done

    average=$(awk "BEGIN {printf \"%.2f\", $total / $runs}")
    printf "  %-30s %6.2fms\n" "$cmd" "$average"
}

test_command "ls"
test_command "echo test"
test_command "pwd"

# Git status only if in repo
if git rev-parse --git-dir &>/dev/null; then
    test_command "git status"
else
    echo "  git status                     (not in repo)"
fi
EOF

zsh "$temp_file" 2>/dev/null
rm -f "$temp_file"
echo ""

# =============================================================================
# Prompt Generation Speed
# =============================================================================

echo -e "${STRONG}Prompt Generation Speed${NC}"
echo "─────────────────────────────────────────────"

temp_file=$(mktemp)
cat > "$temp_file" << EOF
#!/usr/bin/env zsh
zmodload zsh/datetime
source "$ZSHRC_FILE" &>/dev/null

runs=20
total=0

for ((i=1; i<=runs; i++)); do
    start=\$EPOCHREALTIME
    prompt_test=\$PROMPT
    end=\$EPOCHREALTIME
    duration=\$(( (\$end - \$start) * 1000 ))
    total=\$(awk "BEGIN {print \$total + \$duration}")
done

awk "BEGIN {printf \"%.2f\", \$total / \$runs}"
EOF

prompt_time=$(zsh "$temp_file" 2>/dev/null)
rm -f "$temp_file"

echo "  Average prompt generation: ${prompt_time}ms"

prompt_int=${prompt_time%.*}
if (( prompt_int < 50 )); then
    echo -e "  ${GREEN}✓ Excellent (<50ms)${NC}"
elif (( prompt_int < 100 )); then
    echo -e "  ${GREEN}✓ Good (<100ms)${NC}"
else
    echo -e "  ${YELLOW}⚠ Slow (>100ms) - check git cache settings${NC}"
fi
echo ""

# =============================================================================
# Memory Usage
# =============================================================================

echo -e "${STRONG}Memory Usage${NC}"
echo "─────────────────────────────────────────────"

# Find ZSH processes
zsh_mem=$(ps aux | grep "[z]sh" | awk '{sum+=$6} END {printf "%.2f", sum/1024}')

if [[ -n "$zsh_mem" ]]; then
    echo "  ZSH processes: ${zsh_mem} MB"

    mem_int=${zsh_mem%.*}
    if (( mem_int < 10 )); then
        echo -e "  ${GREEN}✓ Excellent (<10MB)${NC}"
    elif (( mem_int < 50 )); then
        echo -e "  ${GREEN}✓ Good (<50MB)${NC}"
    else
        echo -e "  ${YELLOW}⚠ High memory usage${NC}"
    fi
else
    echo "  Could not measure memory usage"
fi
echo ""

# =============================================================================
# Compilation Status
# =============================================================================

echo -e "${STRONG}Compilation Status${NC}"
echo "─────────────────────────────────────────────"

compiled=0
total_files=0

# Check .zshrc
if [[ -f "$ZSHRC_FILE" ]]; then
    total_files=$((total_files + 1))
    [[ -f "$ZSHRC_FILE.zwc" ]] && compiled=$((compiled + 1))
fi

# Check config files
if [[ -d "$NIVUUS_DIR/config" ]]; then
    for config_file in "$NIVUUS_DIR"/config/*.zsh; do
        total_files=$((total_files + 1))
        [[ -f "${config_file}.zwc" ]] && compiled=$((compiled + 1))
    done
fi

echo "  Compiled files: $compiled/$total_files"

if (( compiled == total_files )); then
    echo -e "  ${GREEN}✓ All files compiled${NC}"
elif (( compiled > 0 )); then
    echo -e "  ${YELLOW}⚠ Some files not compiled${NC}"
    echo "  Run: source ~/.zshrc to compile"
else
    echo -e "  ${RED}✗ No files compiled${NC}"
    echo "  Run: source ~/.zshrc to compile"
fi
echo ""

# =============================================================================
# Summary
# =============================================================================

echo "═══════════════════════════════════════════"
echo -e "${GREEN}Benchmark complete!${NC}"
echo "═══════════════════════════════════════════"
echo ""

# Recommendations
echo -e "${STRONG}Recommendations:${NC}"

if (( avg_int > 300 )); then
    echo "  • Shell load time is slow. Try:"
    echo "    - export ENABLE_SYNTAX_HIGHLIGHTING=false"
    echo "    - export ENABLE_PROJECT_DETECTION=false"
    echo "    - export ENABLE_FIREBASE_PROMPT=false"
fi

if (( compiled < total_files )); then
    echo "  • Compile ZSH files for faster loading:"
    echo "    source ~/.zshrc"
fi

if (( prompt_int > 50 )); then
    echo "  • Prompt generation is slow. Try:"
    echo "    export GIT_PROMPT_CACHE_TTL=5"
fi

echo ""
